# Copy to .env. Every key is optional; missing ones fall back to local/canned behaviour.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
MONGODB_URI=
MONGODB_DB=ithaca
TIGER_DSN=
PUBLIC_BASE_URL=http://localhost:8000
CORS_ORIGINS=*
YOUTUBE_API_KEY=
# Auth (optional). When set, agent tools / Chert webhook / admin need header X-Ithaca-Key.
ITHACA_API_KEY=
TOKEN_SECRET=change-me
REQUIRE_FAN_TOKEN=false
HUB_BASE_URL=http://localhost:3000
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
TWITCH_EVENTSUB_SECRET=
