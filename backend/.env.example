# Copy to .env. Every key is optional; missing ones fall back to local/canned behaviour.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
MONGODB_URI=
MONGODB_DB=ithaca
TIGER_DSN=
PUBLIC_BASE_URL=http://127.0.0.1:8080
CORS_ORIGINS=*
YOUTUBE_API_KEY=
# Auth (optional). When set, agent tools / Chert webhook / admin need header X-Ithaca-Key.
ITHACA_API_KEY=
TOKEN_SECRET=change-me
REQUIRE_FAN_TOKEN=false
HUB_BASE_URL=http://localhost:3000
# Part B: Bard voice agent (python -m scripts.setup_bard_agent prints the id)
ELEVENLABS_AGENT_ID=
ELEVENLABS_AGENT_LLM=gemini-2.5-flash
ELEVENLABS_AGENT_PUBLIC=false
# Part B: Chert iMessage (no key = dry run, see GET /chert/outbox)
CHERT_API_KEY=
CHERT_BASE_URL=https://console.trychert.com/api/v1
CHERT_WEBHOOK_SECRET=
CHERT_LINE=
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
TWITCH_EVENTSUB_SECRET=

# Backup AI: a local Ollama model when Gemini fails or runs out of quota (install ollama, then: ollama pull qwen2.5vl:3b)
ORACLE_PROVIDERS=gemini,ollama
TEXT_PROVIDERS=gemini,ollama
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_VISION_MODEL=qwen2.5vl:3b

# Narration: ElevenLabs first, Gemini TTS as the free backup when credits run out (same GEMINI_API_KEY)
TTS_PROVIDERS=elevenlabs,gemini
ELEVENLABS_MODEL=eleven_flash_v2_5
GEMINI_TTS_MODEL=gemini-2.5-flash-preview-tts
GEMINI_TTS_VOICE=Charon
