{
  "manifest_version": 3,
  "name": "The Siren — ITHACA",
  "short_name": "Siren",
  "version": "0.1.0",
  "description": "The Siren sings FaZe lore over every FaZe video you watch. Collect relics, earn Drachmae, find your way home to Ithaca.",
  "minimum_chrome_version": "116",
  "icons": { "16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png" },
  "action": { "default_title": "Open the Siren", "default_icon": { "16": "icons/icon16.png", "48": "icons/icon48.png" } },
  "side_panel": { "default_path": "sidepanel.html" },
  "background": { "service_worker": "background.js", "type": "module" },
  "permissions": ["sidePanel", "storage", "tabs"],
  "host_permissions": [
    "https://www.youtube.com/*",
    "https://www.twitch.tv/*",
    "http://localhost:8000/*"
  ],
  "content_scripts": [
    {
      "matches": ["https://www.youtube.com/*", "https://www.twitch.tv/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": []
}
