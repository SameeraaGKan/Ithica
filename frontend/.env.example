# Empty NEXT_PUBLIC_API_URL = everything runs on mock data (badges say Mock).
# Local backend: http://127.0.0.1:8080 (or :8000). Deployed: https://api.yourdomain.xyz
NEXT_PUBLIC_API_URL=http://127.0.0.1:8080

# ElevenLabs Agent ID for the Bard (person B creates the agent).
# Empty = /onboard shows the typed fallback instead of the voice session.
NEXT_PUBLIC_ELEVENLABS_AGENT_ID=

# Demo fan used by "Enter Ithaca" buttons and the seeded demo.
NEXT_PUBLIC_DEMO_FAN_ID=demo_odysseus
