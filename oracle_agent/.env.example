# Copy to .env.local
# LiveKit project (the one `chert` is connected to)
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
# Must match: chert dev --agent <name>
ORACLE_AGENT_NAME=ithaca-oracle
# The Oracle's voice
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_TTS_MODEL=eleven_flash_v2_5
# ITHACA backend (Part A) - same ITHACA_API_KEY as backend/.env if set there
ITHACA_API_URL=http://localhost:8000
ITHACA_API_KEY=
